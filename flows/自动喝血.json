      "type": "py_func",
      "name": "python函数",
      "params": {
        "code": "import re\n\ndef parse_life(life_list):\n    if not life_list:\n        return 1, 1\n\n    text = str(life_list[0]).strip()\n\n    # 临时调试可以打开：\n    # print(\"parse_life input:\", repr(life_list), repr(text))\n\n    # 支持 \"100/100\"、\"100 / 100\"、\"HP:100/100\"、\"100／100\" 等\n    m = re.search(r'(\\d+)\\s*[/／]\\s*(\\d+)', text)\n    if not m:\n        # 解析不到有效生命值，按你原来的逻辑返回满血，避免流程中断\n        return 1, 1\n\n    cur_life = int(m.group(1))\n    all_life = int(m.group(2))\n\n    if all_life <= 0:\n        return 1, 1\n\n    return cur_life, all_life",
        "func_name": "parse_life",
        "variables": [
          "life_list"
        ],
        "result_var": "res_life"
      },
      "continue_on_fail": false,
      "pair_id": "",
      "commented": false
    },
